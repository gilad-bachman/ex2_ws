<?xml version="1.0" ?>
<argos-configuration>

  <!-- ************************* -->
  <!-- * General configuration * -->
  <!-- ************************* -->
  <framework>
    <system threads="0" />
    <!-- 10 minutes at most. Change random_seed for another start, and other places for the lights. -->
    <experiment length="600" ticks_per_second="10" random_seed="1" />
  </framework>

  <!-- *************** -->
  <!-- * Controllers * -->
  <!-- *************** -->
  <controllers>
    <controller2 library="build/lib/libpipuck_controller2"
                 id="controller2">
      <actuators>
        <pipuck_differential_drive implementation="default" />
        <pipuck_leds implementation="color" medium="leds" />
      </actuators>
      <sensors>
        <!-- range: the rangefinders see up to 20 cm -->
        <pipuck_rangefinders implementation="default" range="0.2" show_rays="true" />
        <!-- the camera sees colored lights around the robot, up to about 2.5 m away. Tall obstacles hide them -->
        <colored_blob_omnidirectional_camera implementation="rot_z_only" medium="leds" show_rays="false" />
        <!-- where the robot is, and which way it faces -->
        <positioning implementation="default" />
        <pipuck_system implementation="default" />
      </sensors>
      <!-- order: the order to visit the lights in. The referee reads it too. Test runs use other orders -->
      <params order="red,green,blue" />
    </controller2>
  </controllers>

  <!-- ****************** -->
  <!-- * Loop functions * -->
  <!-- ****************** -->
  <!-- The referee: places the robot and the lights, runs the battery, scores the mission -->
  <loop_functions library="build/lib/libex2_loop_functions"
                  label="ex2_loop_functions" />

  <!-- *********************** -->
  <!-- * Arena configuration * -->
  <!-- *********************** -->
  <arena size="4, 4, 1" positional_index="grid">
    <!-- walls -->
    <box id="wall_north" size="4,0.1,0.5" movable="false"><body position="0,2,0" orientation="0,0,0"/></box>
    <box id="wall_south" size="4,0.1,0.5" movable="false"><body position="0,-2,0" orientation="0,0,0"/></box>
    <box id="wall_east" size="0.1,4,0.5" movable="false"><body position="2,0,0" orientation="0,0,0"/></box>
    <box id="wall_west" size="0.1,4,0.5" movable="false"><body position="-2,0,0" orientation="0,0,0"/></box>

    <!-- obstacles, 30 cm tall: they block the robot, and hide the lights from its camera -->
    <box id="obstacle_a" size="0.1,0.6,0.3" movable="false"><body position="-0.6,0.8,0" orientation="0,0,0"/></box>
    <box id="obstacle_b" size="0.6,0.1,0.3" movable="false"><body position="0.8,-0.8,0" orientation="0,0,0"/></box>
    <box id="obstacle_c" size="0.5,0.5,0.3" movable="false"><body position="1,0.9,0" orientation="0,0,0"/></box>
    <box id="obstacle_d" size="0.4,0.4,0.3" movable="false"><body position="-1.3,-1.2,0" orientation="0,0,0"/></box>
    <box id="obstacle_e" size="0.3,0.5,0.3" movable="false"><body position="0.1,0.2,0" orientation="0,0,0"/></box>
    <box id="obstacle_f" size="0.5,0.1,0.3" movable="false"><body position="-1.4,0.4,0" orientation="0,0,0"/></box>

    <!-- the three lights, 10 cm above the floor. They have no body: they don't block the robot. The referee moves them to random free places -->
    <light id="light_red" color="red" intensity="100" medium="leds" position="1.7,1.7,0.1"/>
    <light id="light_green" color="green" intensity="100" medium="leds" position="1.7,1.4,0.1"/>
    <light id="light_blue" color="blue" intensity="100" medium="leds" position="1.7,1.1,0.1"/>

    <!-- the robot. The referee moves it to a random free place at the start: that place is the charger -->
    <pipuck id="pipuck0" led_medium="leds" camera_aperture="88">
      <body position="-1.6,-1.6,0" orientation="0,0,0"/>
      <controller config="controller2"/>
    </pipuck>

  </arena>

  <!-- ******************* -->
  <!-- * Physics engines * -->
  <!-- ******************* -->
  <physics_engines>
    <dynamics2d id="dyn2d" />
  </physics_engines>

  <!-- ********* -->
  <!-- * Media * -->
  <!-- ********* -->
  <media>
    <led id="leds"/>
  </media>

  <!-- ****************** -->
  <!-- * Visualization * -->
  <!-- ****************** -->
  <!-- Rings: where a visit to each light counts (filled once visited), and the charger (yellow).
       The number above the robot is its battery -->
  <visualization>
    <qt-opengl show_boundary="false">
      <user_functions library="build/lib/libex2_loop_functions"
                      label="ex2_qt_user_functions" />
      <camera>
        <placements>
          <placement index="0" position="0,0,4.5" look_at="0,0,0" up="0,1,0"/>
        </placements>
      </camera>
    </qt-opengl>
  </visualization>

</argos-configuration>
